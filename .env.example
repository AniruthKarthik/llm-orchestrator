# =============================================================================
# LLM Orchestrator — Environment Configuration Template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# =============================================================================

# =============================================================================
# DATABASE
# Leave empty to use the in-memory store (data will reset on restart).
# =============================================================================
DATABASE_URL=postgres://user:password@localhost:5432/llm_orch?sslmode=disable
MIGRATIONS_PATH=migrations

# =============================================================================
# SERVER
# =============================================================================
SERVER_PORT=:8080

# Log level: "info" (default) or "debug" for verbose output
LOG_LEVEL=info

# CORS: restrict to your UI origin in production. Default is "*" (allow all).
# Example: ALLOWED_ORIGIN=https://app.example.com
ALLOWED_ORIGIN=*

# API Key authentication (optional).
# If set, all API requests must include:
#   X-API-Key: <value>  OR  Authorization: Bearer <value>
# The /api/v1/health endpoint is always public regardless.
# Leave empty to disable authentication (development mode).
API_KEY=

# =============================================================================
# LLM PROVIDER API KEYS
# At least one must be set for workflow execution to work.
# =============================================================================
GROQ_API_KEY=gsk_your_key_here
OPENAI_API_KEY=sk-your_key_here
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
