# Database Configuration (Leave empty to use MemoryStore)
DATABASE_URL=postgres://user:password@localhost:5432/llm_orch?sslmode=disable
MIGRATIONS_PATH=migrations

# Server Configuration
SERVER_PORT=:8080

# LLM Provider API Keys (Required for non-dummy providers)
GROQ_API_KEY=gsk_your_key_here
OPENAI_API_KEY=sk-your_key_here
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
